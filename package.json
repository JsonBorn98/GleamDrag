{
    "name": "gleamdrag",
    "version": "2.2.1",
    "type": "module",
    "scripts": {
        "verify:exit-code": "node scripts/verify_exit_code.mjs",
        "sync:public": "node scripts/sync_public.mjs",
        "build": "node scripts/sync_public.mjs && wxt build -b firefox && wxt build -b chromium",
        "build:test": "node scripts/sync_public.mjs && GLEAMDRAG_TEST_BUILD=1 wxt build -b firefox",
        "zip": "node scripts/sync_public.mjs && wxt build -b firefox && wxt build -b chromium && wxt zip -b firefox && wxt zip -b chromium",
        "test:vitest": "vitest run",
        "verify:vitest-exit-code": "node scripts/verify_vitest_exit_code.mjs",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "^25.0.0",
        "@rollup/plugin-node-resolve": "^15.1.0",
        "@rollup/plugin-replace": "^5.0.2",
        "@rollup/plugin-terser": "^0.4.3",
        "@rollup/plugin-typescript": "^11.1.1",
        "@tsconfig/svelte": "^4.0.1",
        "@types/chai": "^4.3.5",
        "@types/lodash-es": "^4.17.7",
        "@types/mocha": "^10.0.1",
        "@types/node": "^20.2.6",
        "@types/uuid": "^9.0.2",
        "@types/webextension-polyfill": "^0.10.0",
        "@types/ws": "^8.5.5",
        "@wxt-dev/module-svelte": "^2.0.5",
        "chai": "^4.3.7",
        "commander": "^10.0.1",
        "fs-extra": "^11.1.1",
        "lodash": "^4.17.21",
        "lodash-core": "^4.17.19",
        "lodash-es": "^4.17.21",
        "mocha": "^10.2.0",
        "rollup": "^3.24.0",
        "rollup-plugin-svelte": "^7.1.5",
        "simpledotcss": "^2.2.1",
        "svelte": "^5.57.0",
        "svelte-preprocess": "^5.0.4",
        "tldts": "^6.0.5",
        "tslib": "*",
        "typescript": "^5.1.3",
        "uuid": "^9.0.0",
        "vite": "^8.3.0",
        "vitest": "^5.0.1",
        "web-ext": "^7.6.2",
        "webextension-polyfill": "^0.10.0",
        "ws": "^8.13.0",
        "wxt": "0.21.4",
        "zip-dir": "^2.0.0"
    },
    "license": "MIT"
}