{
    "name": "gleamdrag",
    "version": "2.2.1",
    "type": "module",
    "scripts": {
        "sync:public": "node scripts/sync_public.mjs",
        "build": "node scripts/sync_public.mjs && wxt build -b firefox && wxt build -b chromium",
        "build:test": "node scripts/sync_public.mjs && GLEAMDRAG_TEST_BUILD=1 wxt build -b firefox",
        "zip": "node scripts/sync_public.mjs && wxt build -b firefox && wxt build -b chromium && wxt zip -b firefox && wxt zip -b chromium",
        "test:vitest": "vitest run",
        "verify:vitest-exit-code": "node scripts/verify_vitest_exit_code.mjs",
        "test:wxt": "node scripts/test_wxt.mjs",
        "verify:test-wxt": "node scripts/verify_test_wxt.mjs",
        "typecheck": "tsc --noEmit",
        "postinstall": "wxt prepare"
    },
    "devDependencies": {
        "@types/chai": "^4.3.5",
        "@types/lodash-es": "^4.17.7",
        "@types/mocha": "^10.0.1",
        "@types/node": "^20.2.6",
        "@types/webextension-polyfill": "^0.10.0",
        "@wxt-dev/module-svelte": "^2.0.5",
        "chai": "^4.3.7",
        "lodash": "^4.17.21",
        "lodash-es": "^4.17.21",
        "mocha": "^10.2.0",
        "playwright": "^1.63.0",
        "simpledotcss": "^2.2.1",
        "svelte": "^5.57.0",
        "tldts": "^6.0.5",
        "typescript": "^5.1.3",
        "uuid": "^9.0.0",
        "vite": "^8.3.0",
        "vitest": "^5.0.1",
        "web-ext": "^7.6.2",
        "webextension-polyfill": "^0.10.0",
        "ws": "^8.13.0",
        "wxt": "0.21.4"
    },
    "license": "MIT"
}